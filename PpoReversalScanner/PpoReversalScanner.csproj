<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AlgoName>PpoReversalScanner</AlgoName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="*-*" />
  </ItemGroup>

  <!-- Link engine files from other projects so they compile into this cBot. -->
  <ItemGroup>
    <Compile Include="..\PlaybookEngine\PlaybookEngine.cs" Link="PlaybookEngine.cs" />
    <Compile Include="..\PlaybookTradeManager\PlaybookTradeManagerEngine.cs" Link="PlaybookTradeManagerEngine.cs" />
    <Compile Include="..\RsiOscillator\RsiEngine.cs" Link="RsiEngine.cs" />
  </ItemGroup>

  <Target Name="_OverrideAlgoFileName" BeforeTargets="_ExtractMetadata">
    <PropertyGroup>
      <_AlgoFileName>PpoReversalScanner.algo</_AlgoFileName>
      <_AlgoFilePath>$(OutDir)$(_AlgoFileName)</_AlgoFilePath>
      <_AlgoMetadataFileName>$(_AlgoFileName).metadata</_AlgoMetadataFileName>
      <_AlgoMetadataFilePath>$(OutDir)$(_AlgoMetadataFileName)</_AlgoMetadataFilePath>
    </PropertyGroup>
  </Target>

</Project>
